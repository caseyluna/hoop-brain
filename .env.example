# Copy this file to .env.test for local dev (docker compose) / CI parity,
# or to .env for a Neon-pointed session. Real values are never committed —
# see .gitignore.

# --- Local Docker Postgres (docker compose up) ---
POSTGRES_DB=hoopbrain_test
PGPASSWORD=postgres

# --- Postgres connection ---
# Pooled: what the running app uses at request time (api, sync-engine).
#   Local Docker Postgres: postgresql://postgres:postgres@db:5432/hoopbrain_test
#   Neon: the "-pooler" connection string (Neon dashboard, or
#     `neon connection-string --pooled` once linked — see pyproject/CLAUDE.md
#     for Neon CLI setup).
DATABASE_URL=

# Direct (unpooled): Alembic migrations only (`alembic upgrade head`). Neon's
# pooler runs PgBouncer in transaction mode, which doesn't support the
# session-level behavior Alembic needs. Local Docker Postgres has no
# pooled/direct distinction, so this can be left unset there —
# api/alembic/env.py falls back to DATABASE_URL when it's unset.
#   Neon: the connection string WITHOUT the "-pooler" suffix on the hostname
#     (`neon connection-string` with no flag).
DATABASE_URL_DIRECT=

# GCP service account JSON, used by ingestion/transformation/sync to read
# from GCS/BigQuery — see docs/hoop-brain-data-source-catalog.md.
GOOGLE_APPLICATION_CREDENTIALS=/keys/service_account.json
